{
  "manifest_version": 3,
  "name": "Grok Imagine Downloader",
  "version": "1.0",
  "description": "Download all currently loaded images from Grok Imagine",
  "permissions": ["activeTab", "downloads", "scripting"],
  "host_permissions": [
    "https://imagine-public.x.ai/*",
    "https://*.x.ai/*",
    "https://grok.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}